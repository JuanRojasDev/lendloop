# Copy to .env.n8n. Generate each secret with: openssl rand -hex 32
# Convex signs outgoing webhooks with the first one and verifies n8n with the second.
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# The Convex HTTP actions URL. From Docker, a local deployment is reached through
# host.docker.internal. For a cloud deployment use https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211
